<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>FlashXlsx</PackageId>
    <Version>1.0.0</Version>
    <Authors>Nicolas</Authors>
    <Description>Sérialiseur et désérialiseur XLSX haute performance en streaming, 100% compatible Native AOT grâce à un Source Generator Roslyn.</Description>
    <PackageTags>xlsx;excel;aot;source-generator;streaming;openxml</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logoFlashXlsx.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\logoFlashXlsx.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le XML anglais va dans le dossier satellite lib/net10.0/en/ -->
    <None Include="docs\FlashXlsx.en.xml" Pack="true" PackagePath="lib/net10.0/en/FlashXlsx.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlashXlsx.Abstractions\FlashXlsx.Abstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FlashXlsx.Generators\FlashXlsx.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;IsAotCompatible" />
  </ItemGroup>

  <ItemGroup>
    <!-- DLL Abstractions -->
    <None Include="..\FlashXlsx.Abstractions\bin\$(Configuration)\net10.0\FlashXlsx.Abstractions.dll"
          Pack="true" PackagePath="lib/net10.0" Visible="false" />

    <!-- Doc XML Abstractions en FRANÇAIS (défaut) -->
    <None Include="..\FlashXlsx.Abstractions\bin\$(Configuration)\net10.0\FlashXlsx.Abstractions.xml"
          Pack="true" PackagePath="lib/net10.0" Visible="false" />

    <!-- Doc XML Abstractions en ANGLAIS -->
    <None Include="..\FlashXlsx.Abstractions\docs\FlashXlsx.Abstractions.en.xml"
          Pack="true" PackagePath="lib/net10.0/en/FlashXlsx.Abstractions.xml" Visible="false" />

    <!-- DLL Generator -->
    <None Include="..\FlashXlsx.Generators\bin\$(Configuration)\netstandard2.0\FlashXlsx.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>