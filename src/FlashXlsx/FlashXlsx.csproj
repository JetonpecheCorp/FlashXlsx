<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>FlashXlsx</PackageId>
    <Version>1.0.0</Version>
    <Authors>Jetonpeche</Authors>
    <Description>Ultra-fast, lightweight streaming XLSX engine for .NET 10. Built for extreme throughput and minimal memory footprint, with zero-allocation dynamic records and 100% Native AOT compatibility via Roslyn Source Generators.</Description>    
    <PackageTags>xlsx;excel;aot;source-generator;streaming;openxml;performance;high-performance</PackageTags>    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logoFlashXlsx.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Liens vers le repo GitHub -->
    <PackageProjectUrl>https://github.com/JetonpecheCorp/FlashXlsx</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JetonpecheCorp/FlashXlsx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Initial 1.0.0 release: high-throughput streaming engine, Roslyn source generator, zero-boxing dynamic dictionary support (XlsxValue), fluent multi-sheet builders, and instant OLE2 encryption detection.</PackageReleaseNotes>

        <!-- Pour le débogage distant -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\logoFlashXlsx.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le XML anglais va dans le dossier satellite lib/net10.0/en/ -->
    <None Include="docs\FlashXlsx.en.xml" Pack="true" PackagePath="lib/net10.0/en/FlashXlsx.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlashXlsx.Abstractions\FlashXlsx.Abstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\FlashXlsx.Generators\FlashXlsx.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;IsAotCompatible" />
  </ItemGroup>

  <ItemGroup>
    <!-- DLL Abstractions -->
    <None Include="..\FlashXlsx.Abstractions\bin\$(Configuration)\net10.0\FlashXlsx.Abstractions.dll"
          Pack="true" PackagePath="lib/net10.0" Visible="false" />

    <!-- Doc XML Abstractions en FRANÇAIS (défaut) -->
    <None Include="..\FlashXlsx.Abstractions\bin\$(Configuration)\net10.0\FlashXlsx.Abstractions.xml"
          Pack="true" PackagePath="lib/net10.0" Visible="false" />

    <!-- Doc XML Abstractions en ANGLAIS -->
    <None Include="..\FlashXlsx.Abstractions\docs\FlashXlsx.Abstractions.en.xml"
          Pack="true" PackagePath="lib/net10.0/en/FlashXlsx.Abstractions.xml" Visible="false" />

    <!-- DLL Generator -->
    <None Include="..\FlashXlsx.Generators\bin\$(Configuration)\netstandard2.0\FlashXlsx.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>